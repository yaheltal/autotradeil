ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWT_SECRET=your-hmac-jwt-secret-from-supabase-api-settings
CORS_ORIGINS=["http://localhost:3000"]

# Resend (transactional email) — get key at https://resend.com/api-keys
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Impersonation — generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
IMPERSONATION_SECRET=generate-with-python3-secrets-token-hex-32

# Cloudinary — image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
