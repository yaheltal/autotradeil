ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWT_SECRET=your-hmac-jwt-secret-from-supabase-api-settings
CORS_ORIGINS=["http://localhost:3000"]

# Resend (transactional email — PRIMARY) — https://resend.com/api-keys
# Production uses the verified autotradeil.com domain. For dev use the
# onboarding@resend.dev placeholder until the domain is verified.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="AutoTradeIL <info@autotradeil.com>"
# Customer replies route here regardless of which sender (Resend
# primary or Gmail fallback) actually delivered the message.
REPLY_TO_EMAIL=support@autotradeil.com

# Impersonation — generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
IMPERSONATION_SECRET=generate-with-python3-secrets-token-hex-32

# Cloudinary — image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic — vision model for AI vehicle identification
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twilio — SMS OTP
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+972XXXXXXXXX

# Gmail SMTP — FALLBACK only when Resend errors / is not configured.
# Production points GMAIL_FROM at the same address as RESEND_FROM_EMAIL
# so customers see one consistent sender.
GMAIL_FROM=info@autotradeil.com
GMAIL_APP_PASSWORD=your_16_char_app_password
